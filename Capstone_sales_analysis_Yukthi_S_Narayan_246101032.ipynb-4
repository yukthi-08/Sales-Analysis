    {
      "cell_type": "code",
      "source": [
        "tree = DecisionTreeRegressor(max_depth=5, min_samples_leaf=50, random_state=42).fit(Xtr, ytr)\n",
        "pred = tree.predict(Xte)\n",
        "print(\"Decision Tree   -> Test R2 = %.3f | RMSE = %.2f | MAE = %.2f\" % (r2_score(yte, pred), np.sqrt(mean_squared_error(yte, pred)), mean_absolute_error(yte, pred)))\n",
        "ols_tr = sm.OLS(ytr, sm.add_constant(Xtr)).fit(); p2 = ols_tr.predict(sm.add_constant(Xte))\n",
        "print(\"OLS (same split)-> Test R2 = %.3f | RMSE = %.2f | MAE = %.2f\" % (r2_score(yte, p2), np.sqrt(mean_squared_error(yte, p2)), mean_absolute_error(yte, p2)))\n",
        "\n",
        "imp = pd.Series(tree.feature_importances_, X.columns).sort_values(ascending=False)\n",
        "imp[imp > 0].sort_values().plot(kind=\"barh\"); plt.title(\"Decision Tree Feature Importance\"); plt.show()\n",
        "print(imp.head(8).round(3))\n",
        "\n",
        "plt.figure(figsize=(20, 8))\n",
        "plot_tree(tree, max_depth=3, feature_names=X.columns, filled=True, rounded=True, fontsize=8)\n",
        "plt.title(\"Decision Tree (top 3 levels shown)\"); plt.show()"
      ],
