      "source": [
        "ma = pd.DataFrame({\"Actual\": ts, \"MA_7\": ts.rolling(7).mean(), \"MA_30\": ts.rolling(30).mean()})\n",
        "ma.plot(lw=1.2, figsize=(12, 5)); plt.title(\"Moving Averages (7-day and 30-day)\"); plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 503
        },
        "id": "lsRO4VmgRCPi",
        "outputId": "55cc01d8-88a5-4184-85f6-9e9b8151cbd5"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1200x500 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "h = 30                                   # hold out last 30 days\n",
        "train, test = ts[:-h], ts[-h:]\n",
        "\n",
        "ma_fc = pd.Series(train.rolling(7).mean().iloc[-1], index=test.index)   # moving-average forecast\n",
        "\n",
        "ses = SimpleExpSmoothing(train, initialization_method=\"estimated\").fit()\n",
        "ses_fc = ses.forecast(h)\n",
        "\n",
        "holt = ExponentialSmoothing(train, trend=\"add\", initialization_method=\"estimated\").fit()   # double exponential\n",
        "holt_fc = holt.forecast(h)\n",
        "\n",
        "print(\"SES alpha = %.3f\" % ses.params[\"smoothing_level\"])\n",
        "print(\"Holt alpha = %.3f, beta = %.4f\" % (holt.params[\"smoothing_level\"], holt.params[\"smoothing_trend\"]))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "dHwsRXlZREmE",
        "outputId": "c76a771f-45c4-4383-b056-c710bc50bfb8"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "SES alpha = 0.539\n",
            "Holt alpha = 0.539, beta = 0.0000\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def metrics(a, f):\n",
        "    return {\"RMSE\": np.sqrt(mean_squared_error(a, f)), \"MAE\": mean_absolute_error(a, f),\n",
        "            \"MAPE %\": np.mean(np.abs((a - f) / a)) * 100}\n",
        "\n",
        "comp = pd.DataFrame({\"Moving Avg (7)\": metrics(test, ma_fc),\n",
        "                     \"Simple Exp. Smoothing\": metrics(test, ses_fc),\n",
        "                     \"Double Exp. (Holt)\": metrics(test, holt_fc)}).T.round(2)\n",
        "display(comp)\n",
        "\n",
        "plt.figure(figsize=(12, 5))\n",
        "train[-90:].plot(label=\"Train (last 90 days)\", color=\"grey\")\n",
        "test.plot(label=\"Actual\", color=\"black\", lw=2)\n",
        "ma_fc.plot(label=\"Moving Avg\", ls=\"--\"); ses_fc.plot(label=\"SES\", ls=\"--\"); holt_fc.plot(label=\"Holt (Double Exp.)\", ls=\"--\")\n",
        "plt.legend(); plt.title(\"Forecast vs Actual - last 30 days\"); plt.show()"
      ],
      "metadata": {
