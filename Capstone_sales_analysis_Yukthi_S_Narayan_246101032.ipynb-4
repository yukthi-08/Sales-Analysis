    {
      "cell_type": "code",
      "source": [
        "final = ExponentialSmoothing(ts, trend=\"add\", initialization_method=\"estimated\").fit()\n",
        "fc = final.forecast(30)\n",
        "plt.figure(figsize=(12, 5))\n",
        "ts[-120:].plot(label=\"History\"); fc.plot(label=\"30-day forecast\", color=\"red\")\n",
        "plt.legend(); plt.title(\"30-Day Forecast (Holt)\"); plt.show()\n",
        "print(fc.round(0).iloc[[0, -1]])"
      ],
