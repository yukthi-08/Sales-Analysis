    {
      "cell_type": "code",
      "source": [
        "X = pd.get_dummies(df[[\"Inventory Level\",\"Units Ordered\",\"Price\",\"Discount\",\"Category\",\"Region\"]], drop_first=True, dtype=float)\n",
        "y = df[\"Units Sold\"]\n",
        "ols = sm.OLS(y, sm.add_constant(X)).fit()\n",
        "print(ols.summary())"
