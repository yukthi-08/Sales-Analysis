    {
      "cell_type": "code",
      "source": [
        "num_cols = [\"Inventory Level\",\"Units Sold\",\"Units Ordered\",\"Price\",\"Discount\"]\n",
        "desc = df[num_cols].agg([\"count\",\"mean\",\"median\",\"std\",\"min\",\"max\",\"skew\"]).T\n",
        "desc[\"mode\"] = [df[c].mode()[0] for c in num_cols]\n",
        "desc[\"CV %\"] = desc[\"std\"] / desc[\"mean\"] * 100\n",
        "display(desc.round(2))\n",
        "\n",
        "print(df.groupby(\"Category\")[\"Units Sold\"].agg([\"mean\",\"median\",\"std\"]).round(1).sort_values(\"mean\", ascending=False))\n",
        "print(df.groupby(\"Region\")[\"Units Sold\"].agg([\"mean\",\"median\",\"std\"]).round(1))\n",
        "print(\"\\nShare of records with zero Units Ordered: %.1f%%\" % ((df[\"Units Ordered\"] == 0).mean() * 100))"
      ],
