      "source": [
        "ts = df.groupby(\"Date\")[\"Units Sold\"].sum().asfreq(\"D\")\n",
        "print(\"Missing days:\", ts.isna().sum()); ts = ts.interpolate()\n",
        "ts.plot(title=\"Daily Total Units Sold\"); plt.ylabel(\"Units\"); plt.show()\n",
        "print(ts.describe().round(1))\n",
        "\n",
        "seasonal_decompose(ts, model=\"additive\", period=7).plot(); plt.tight_layout(); plt.show()\n",
        "print(\"Avg units by month:\\n\", ts.groupby(ts.index.month).mean().round(0))\n",
        "print(\"Avg units by weekday (0=Mon):\\n\", ts.groupby(ts.index.dayofweek).mean().round(0))"
